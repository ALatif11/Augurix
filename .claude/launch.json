{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["dashboard.py"],
      "port": 8000
    },
    {
      "name": "augurix-static",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8010", "--bind", "127.0.0.1", "--directory", "augurix-static"],
      "port": 8010
    }
  ]
}
